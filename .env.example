# NEXA uses the same Supabase project as NTH (nth-aspirant-ui).
#
# Vite env loading (same as NTH):
#   npm run dev              → development (.env, .env.development, *.local)
#   npm run build:dev        → development build
#   npm run build / build:prod → production (.env, .env.production, *.local)
#
# Tracked in git: .env.development (dev Supabase), .env.production (prod Supabase)
# Gitignored: .env (optional local overrides), .env.local, .env.*.local

# Public site URL for canonical, Open Graph, and sitemap (no trailing slash)
VITE_SITE_URL=https://nexatalenthire.com

# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
